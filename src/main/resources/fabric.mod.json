{
	"schemaVersion": 1,
	"id": "travellers-handbook",
	"version": "${version}",
	"name": "Traveller's Handbook",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/travellers-handbook/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.rasanovum.travellershandbook.TravellersHandbook"
		],
		"client": [
			"net.rasanovum.travellershandbook.client.TravellersHandbookClient"
		]
	},
	"mixins": [
		"travellers-handbook.mixins.json",
		{
			"config": "travellers-handbook.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"
