{
	"schemaVersion": 1,
	"id": "travellers-handbook",
	"version": "${version}",
	"name": "Traveller's Handbook",
	"description": "A mod that adds a journal filled with entries that the player can discover as they explore the world around them.",
	"authors": [
		"Rasa Novum"
	],
	"contact": {
		"homepage": "https://rasanovum.ca",
		"sources": "https://github.com/RasaNovum/Travellers_Handbook"
	},
	"license": "RSL-1.0",
	"icon": "assets/travellers-handbook/TH_Icon_Logo_8x.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.rasanovum.travellershandbook.loaders.fabric.FabricMain"
		],
		"client": [
			"net.rasanovum.travellershandbook.loaders.fabric.FabricClient"
		]
	},
	"mixins": [
		"travellers-handbook.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${fabric_loader_min_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=${java_version}",
		"fabric-api": "*",
		"midnightlib": ">=${midnightlib_min_version}"
	}
}
